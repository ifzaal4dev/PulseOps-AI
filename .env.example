# PulseOps environment template
# Copy to .env and adjust. Local runs use SQLite and need no secrets.

# --- Backend (apps/api) ---
# SQLite (zero-setup local dev + fast tests). Containers/deployments use
# PostgreSQL — see docker-compose.yml:
#   PULSEOPS_DATABASE_URL=postgresql+psycopg://pulseops:pulseops@localhost:5432/pulseops
PULSEOPS_DATABASE_URL=sqlite:///./pulseops.db
# Allowed CORS origin for the web app
PULSEOPS_CORS_ORIGIN=http://localhost:3000
# POST /api/demo/reset wipes and reseeds the database. Set false on any
# shared deployment.
PULSEOPS_ENABLE_DEMO_RESET=true

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Hybrid reasoning ------------------------------------------------------
# Modes: deterministic (default, no keys needed) | llm | hybrid.
# There is NO default model: pick one your key can actually use — verify with
#   python -m pulseops_api.reasoning_smoke --provider gemini --list-models
#   python -m pulseops_api.reasoning_smoke --provider openrouter --list-models
# then confirm with a single bounded live call:
#   python -m pulseops_api.reasoning_smoke --provider <p> --model <id> --diagnose
# Any provider failure at runtime falls back to the deterministic diagnosis.
#
# Gemini example:
#   PULSEOPS_REASONING_MODE=hybrid
#   PULSEOPS_LLM_PROVIDER=gemini
#   PULSEOPS_LLM_MODEL=<model id from --list-models, e.g. a gemini-*-flash>
#   GEMINI_API_KEY=your-key-here            # or GOOGLE_API_KEY
#
# OpenRouter example:
#   PULSEOPS_REASONING_MODE=hybrid
#   PULSEOPS_LLM_PROVIDER=openrouter
#   PULSEOPS_LLM_MODEL=<slug from --list-models with structured-output support>
#   OPENROUTER_API_KEY=your-key-here
#   OPENROUTER_HTTP_REFERER=https://your-app.example   # optional attribution
#   OPENROUTER_APP_TITLE=PulseOps                       # optional
#
# Anthropic (optional): PULSEOPS_LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY.
#
# SAFER WORKFLOWS (recommended over putting keys in .env):
#   * external env file kept outside the repo:
#       docker compose --env-file /secure/path/pulseops.env up
#   * mounted secret file (see the worked example in docker-compose.yml):
#       put the key in ./secrets/gemini.key (gitignored) and set
#       GEMINI_API_KEY_FILE=/run/secrets/gemini.key
# Keys are read server-side from the environment/secret files only — never
# commit them, never expose them via NEXT_PUBLIC_*, never paste them into
# chats/logs; CI runs with no keys (fake providers).
PULSEOPS_REASONING_MODE=deterministic
#PULSEOPS_LLM_PROVIDER=gemini
#PULSEOPS_LLM_MODEL=
PULSEOPS_LLM_TIMEOUT_SECONDS=20
PULSEOPS_LLM_MAX_OUTPUT_TOKENS=1500
PULSEOPS_LLM_TEMPERATURE=0.1
PULSEOPS_MAX_DIAGNOSTIC_ROUNDS=1

# --- ML / replay data ---
# Processed MetroPT-3 Parquet for the Replay Lab. Local dev finds it at the
# in-repo default (ml/datasets/processed/metropt3.parquet, produced by
# `python -m pulseops_ml.ingest`); containers set this to the bind-mounted
# path (docker-compose.yml mounts the host file to /data/metropt3.parquet).
#PULSEOPS_METROPT_PARQUET=/data/metropt3.parquet
# Trained-artifact directory override (compose mounts ml/model_artifacts here).
#PULSEOPS_ARTIFACTS_DIR=/artifacts

